{
  "name": "ax-clipforge-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:app": "oxlint src --ignore-pattern \"**/tests/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"**/*.spec.tsx\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "tsc": "tsc -b --pretty false",
    "tsc:app": "tsc --noEmit -p tsconfig.no-tests.json --pretty false",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "verify": "bun lint && bun format:check && bun tsc && bun tsc:app && bun run test && bun run fallow:dead",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "allow-scripts": "allow-scripts",
    "check-install-scripts": "node scripts/check-install-scripts.mjs",
    "prepare": "husky"
  },
  "author": {
    "name": "Atanu Debbarma",
    "url": "https://github.com/AtanuDebbarma"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@lavamoat/allow-scripts": "5.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "babel-jest": "29.7.0",
    "fallow": "3.6.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "oxc-transform-react": "0.148.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "trustedDependencies": [
    "vite",
    "@vitejs/plugin-react",
    "tailwindcss",
    "esbuild",
    "unrs-resolver",
    "core-js"
  ],
  "lavamoat": {
    "allowScripts": {
      "esbuild": true,
      "unrs-resolver": true,
      "core-js": true,
      "$root$": false
    }
  }
}
