{
  "name": "ax-clipforge-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:app": "oxlint src --ignore-pattern \"**/tests/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"**/*.spec.tsx\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "tsc": "tsc -b --pretty false",
    "tsc:app": "tsc --noEmit -p tsconfig.no-tests.json --pretty false",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "verify": "bun lint && bun format:check && bun tsc && bun tsc:app && bun run test && bun run fallow:dead",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "allow-scripts": "allow-scripts",
    "check-install-scripts": "node scripts/check-install-scripts.mjs",
    "prepare": "husky"
  },
  "author": {
    "name": "Atanu Debbarma",
    "url": "https://github.com/AtanuDebbarma"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@lavamoat/allow-scripts": "5.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-jest": "30.5.2",
    "fallow": "3.32.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "oxc-transform-react": "0.153.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "trustedDependencies": [
    "vite",
    "@vitejs/plugin-react",
    "tailwindcss",
    "esbuild",
    "unrs-resolver",
    "core-js"
  ],
  "lavamoat": {
    "allowScripts": {
      "esbuild": true,
      "unrs-resolver": true,
      "core-js": true,
      "jest>@jest/core>jest-haste-map>@parcel/watcher": false,
      "jest>@jest/core>jest-resolve>unrs-resolver": false,
      "$root$": false
    }
  }
}
