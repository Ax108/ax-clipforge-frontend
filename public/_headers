# ClipForge security headers (static hosts that copy public/ to dist).
# Third parties used by this app:
#   - fonts.googleapis.com / fonts.gstatic.com  Inter + JetBrains Mono
#   - youtube-nocookie.com / youtube.com / i.ytimg.com  embeds, oEmbed, thumbnails

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://img.youtube.com; connect-src 'self' https://www.youtube-nocookie.com https://www.youtube.com http://localhost:5000; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), picture-in-picture=(self "https://www.youtube.com" "https://youtube.com" "https://www.youtube-nocookie.com"), fullscreen=(self "https://www.youtube.com" "https://youtube.com" "https://www.youtube-nocookie.com"), autoplay=(self "https://www.youtube.com" "https://youtube.com" "https://www.youtube-nocookie.com"), encrypted-media=(self "https://www.youtube.com" "https://youtube.com" "https://www.youtube-nocookie.com"), accelerometer=(self "https://www.youtube.com" "https://youtube.com" "https://www.youtube-nocookie.com"), gyroscope=(self "https://www.youtube.com" "https://youtube.com" "https://www.youtube-nocookie.com"), clipboard-write=(self)
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
